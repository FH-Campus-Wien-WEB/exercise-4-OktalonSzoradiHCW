{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "files": {
    "includes": ["**"],
    "ignoreUnknown": false
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "recommended": true,
        "noNoninteractiveElementInteractions": "error"
      },
      "complexity": {
        "recommended": true,
        "noExcessiveCognitiveComplexity": "error",
        "noForEach": "error",
        "noImplicitCoercions": "error",
        "noUselessCatchBinding": "error",
        "noUselessStringConcat": "error",
        "noUselessUndefined": "error",
        "noVoid": "error",
        "useSimplifiedLogicExpression": "error",
        "useWhile": "error"
      },
      "correctness": {
        "recommended": true,
        "noGlobalDirnameFilename": "error",
        "noProcessGlobal": "error",
        "noUndeclaredDependencies": "error",
        "noUndeclaredVariables": "error",
        "noUnresolvedImports": "error",
        "useImportExtensions": "error",
        "useSingleJsDocAsterisk": "error"
      },
      "nursery": {
        "recommended": true,
        "noAmbiguousAnchorText": "error",
        "noBaseToString": "error",
        "noDivRegex": "error",
        "noEqualsToNull": "error",
        "noExcessiveNestedCallbacks": "error",
        "noFloatingClasses": "error",
        "noImpliedEval": "error",
        "noIncrementDecrement": "error",
        "noInlineStyles": "error",
        "noLoopFunc": "error",
        "noMultiAssign": "error",
        "noMultiStr": "error",
        "noNestedPromises": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noProto": "error",
        "noRedundantDefaultExport": "error",
        "noReturnAssign": "error",
        "noScriptUrl": "error",
        "noShadow": "error",
        "noSyncScripts": "error",
        "noUnnecessaryConditions": "error",
        "noUnnecessaryTemplateExpression": "error",
        "noUnsafePlusOperands": "error",
        "noUselessReturn": "error",
        "noUselessTypeConversion": "error",
        "useArraySome": "error",
        "useAwaitThenable": "error",
        "useDestructuring": "error",
        "useDisposables": "error",
        "useDomNodeTextContent": "error",
        "useDomQuerySelector": "error",
        "useErrorCause": "error",
        "useExhaustiveSwitchCases": "error",
        "useFind": "error",
        "useGlobalThis": "error",
        "useIframeSandbox": "error",
        "useImportsFirst": "error",
        "useMathMinMax": "error",
        "useNamedCaptureGroup": "error",
        "useNullishCoalescing": "error",
        "useRegexpExec": "error",
        "useRegexpTest": "error",
        "useSortedClasses": "error",
        "useSpread": "error",
        "useStringStartsEndsWith": "error",
        "useUnicodeRegex": "error",
        "noEmptyObjectKeys": "error",
        "noTopLevelLiterals": "error",
        "noUntrustedLicenses": "error"
      },
      "performance": {
        "recommended": true,
        "noAwaitInLoops": "error",
        "noBarrelFile": "error",
        "noDelete": "error"
      },
      "security": {
        "recommended": true,
        "noSecrets": "error"
      },
      "style": {
        "recommended": true,
        "noCommonJs": "error",
        "noExportedImports": "error",
        "noMagicNumbers": "error",
        "noNegationElse": "error",
        "noNestedTernary": "error",
        "noParameterAssign": "error",
        "noProcessEnv": "error",
        "noSubstr": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "noYodaExpression": "error",
        "useAtIndex": "error",
        "useBlockStatements": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useConsistentArrowReturn": "error",
        "useConsistentBuiltinInstantiation": "error",
        "useConsistentObjectDefinitions": "warn",
        "useExplicitLengthCheck": "error",
        "useExportsLast": "error",
        "useForOf": "error",
        "useGroupedAccessorPairs": "error",
        "useNumberNamespace": "error",
        "useNumericSeparators": "error",
        "useObjectSpread": "error",
        "useShorthandAssign": "error",
        "useSingleVarDeclarator": "error",
        "useSymbolDescription": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useTrimStartEnd": "error"
      },
      "suspicious": {
        "recommended": true,
        "noAlert": "error",
        "noBitwiseOperators": "error",
        "noConstantBinaryExpressions": "error",
        "noDeprecatedImports": "error",
        "noEmptyBlockStatements": "error",
        "noEmptySource": "error",
        "noImportCycles": "error",
        "noUnassignedVariables": "error",
        "noUnusedExpressions": "error",
        "noVar": "error",
        "useAwait": "error",
        "useErrorMessage": "error",
        "useGuardForIn": "error",
        "useNumberToFixedDigitsArgument": "error",
        "useStaticResponseMethods": "error",
        "useStrictMode": "error",
        "noDuplicateDependencies": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "recommended": true,
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "auto",
    "trailingNewline": true,
    "useEditorconfig": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "trailingCommas": "none",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded",
      "enabled": true,
      "operatorLinebreak": "after"
    },
    "linter": {
      "enabled": true
    },
    "assist": {
      "enabled": true
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    },
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    },
    "assist": {
      "enabled": true
    }
  },
  "css": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "single"
    },
    "linter": {
      "enabled": true
    },
    "assist": {
      "enabled": true
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "whitespaceSensitivity": "css",
      "indentScriptAndStyle": true,
      "selfCloseVoidElements": "never"
    },
    "linter": {
      "enabled": true
    },
    "assist": {
      "enabled": true
    }
  }
}
